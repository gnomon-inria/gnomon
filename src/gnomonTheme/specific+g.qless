/* Code: */

/* // ///////////////////////////////////////////////////////////////////////////// */
/* //                                                                               */
/* // ///////////////////////////////////////////////////////////////////////////// */

dtkWidgetsMenuBar#RHS
{
    background: alpha(@base0, 00);
}

/* // ///////////////////////////////////////////////////////////////////////////// */
/* //                                                                               */
/* // ///////////////////////////////////////////////////////////////////////////// */


dtkWidgetsWorkspaceBar::tab
{
    width: 200px;
    font-size: 18pt;
    font-weight: normal;
}

dtkWidgetsWorkspaceBar::tab:!selected
{
    background-color: @base2;
    font-weight: bold;
}

/* // ///////////////////////////////////////////////////////////////////////////// */
/* //                                                                               */
/* // ///////////////////////////////////////////////////////////////////////////// */

gnomonViewForm > QSlider
{
    border: none;
}

/* // ///////////////////////////////////////////////////////////////////////////// */
/* //                                                                               */
/* // ///////////////////////////////////////////////////////////////////////////// */

gnomonWorkspaceBrowser > QLineEdit
{
    border: none;
    border-bottom: 1px solid @base1;
    border-radius: 0;

    font-weight: normal;
    font-size: 12px;
}

gnomonWorkspaceBrowser > QToolButton
{
    border: none;
}

gnomonFinderListView
{
    font-weight: normal;
    font-size: 12px;
}


gnomonFinderListView::item
{
    height: 100px;
}

/* // ///////////////////////////////////////////////////////////////////////////// */
/* //                                                                               */
/* // ///////////////////////////////////////////////////////////////////////////// */

gnomonMessageBoard > QLabel
{
    color: @base2;
    font-size: 32px;
}

/* specific+g.qless ends here */
