gnomonViewForm > QSlider
{
    border: none;
}

/* // ///////////////////////////////////////////////////////////////////////////// */
/* //                                                                               */
/* // ///////////////////////////////////////////////////////////////////////////// */

gnomonWorkspaceBrowser > QLineEdit
{
    border: none;
    border-bottom: 1px solid @base1;
    border-radius: 0;

    font-weight: normal;
    font-size: 12px;
}

gnomonWorkspaceBrowser > QToolButton
{
    border: none;
}

gnomonWorkspaceBrowser > QListView::item
{
    font-weight: normal;
    font-size: 10px;
}

/* // ///////////////////////////////////////////////////////////////////////////// */
/* //                                                                               */
/* // ///////////////////////////////////////////////////////////////////////////// */

gnomonMessageBoard > QLabel
{
    color: @base2;
    font-size: 32px;
}

