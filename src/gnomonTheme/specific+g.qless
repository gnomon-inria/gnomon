/* Code: */


/* // ///////////////////////////////////////////////////////////////////////////// */
/* //                                                                               */
/* // ///////////////////////////////////////////////////////////////////////////// */

dtkWidgetsMenuBar#RHS
{
    background: alpha(@base0, 00);
}

/* // ///////////////////////////////////////////////////////////////////////////// */
/* //                                                                               */
/* // ///////////////////////////////////////////////////////////////////////////// */

gnomonVtkView > QSlider
{
    border: none;
}

/* // ///////////////////////////////////////////////////////////////////////////// */
/* //                                                                               */
/* // ///////////////////////////////////////////////////////////////////////////// */

gnomonWorkspaceBrowser > QLineEdit
{
    border: none;
    border-bottom: 1px solid @base1;
    border-radius: 0;

    font-weight: normal;
    font-size: 12px;
}

gnomonWorkspaceBrowser > QToolButton
{
    border: none;
}

gnomonFinderListView
{
    font-weight: normal;
    font-size: 12px;
}


gnomonFinderListView::item
{
    height: 100px;
}

/* // ///////////////////////////////////////////////////////////////////////////// */
/* //                                                                               */
/* // ///////////////////////////////////////////////////////////////////////////// */

gnomonMessageBoard > QLabel
{
    color: @base2;
    font-size: 32px;
}

/* // ///////////////////////////////////////////////////////////////////////////// */
/* //                                                                               */
/* // ///////////////////////////////////////////////////////////////////////////// */

gnomonWorkspaceLSystemSimulator QTabWidget::pane
{
    background-color: transparent;

    border: none;
    border-bottom: 1px solid @base0;
}

gnomonWorkspaceLSystemSimulator QTabWidget::tab-bar
{
    margin: 0;
    margin-top: 1;

    padding: 0;

    background-color: transparent;
}

gnomonWorkspaceLSystemSimulator QTabBar::tab
{
    margin-top: 0px;
    margin-bottom: 0px;
    margin-left: 0px;

    padding: 6px;

    background-color: @bg;

    border: none;
    border-radius: 0;
    border-right: 1px solid @base0;

    font-size: 12px;
    font-weight: bold;

    color: @fgalt;
}

gnomonWorkspaceLSystemSimulator QTabBar::tab:last:selected
{
    background-color: @base2;
}

gnomonWorkspaceLSystemSimulator QTabBar::tab:selected, gnomonWorkspaceLSystemSimulator QTabBar::tab:hover
{
    background-color: @base2;
}

/* // ///////////////////////////////////////////////////////////////////////////// */
/* //                                                                               */
/* // ///////////////////////////////////////////////////////////////////////////// */

gnomonWidgetsWorkspaceBar
{
    border-top: 1px solid @base0;
}

gnomonWidgetsWorkspaceBar::tab:last
{
    margin-left: 10px;
}

gnomonWidgetsWorkspaceBar::tab:last QIcon, gnomonWidgetsWorkspaceBar::tab:last QPixmap
{
    width: 60px;
    height: 60px;
}

/* specific+g.qless ends here */
