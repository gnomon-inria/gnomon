/* // ///////////////////////////////////////////////////////////////////////////// */
/* // QDialog                                                                       */
/* // ///////////////////////////////////////////////////////////////////////////// */

QDialog
{
    background: @bg;
}

/* // ///////////////////////////////////////////////////////////////////////////// */
/* // QDialog                                                                       */
/* // ///////////////////////////////////////////////////////////////////////////// */

QMainWindow
{
    background: @bg;
}


/* // ///////////////////////////////////////////////////////////////////////////// */
/* // QSplitter                                                                     */
/* // ///////////////////////////////////////////////////////////////////////////// */

QSplitter::handle
{
    background: @base0;
}

QSplitter::handle:horizontal
{
    width: 1px;
}

QSplitter::handle:vertical
{
    height: 1px;
}

/* // ///////////////////////////////////////////////////////////////////////////// */
/* // QToolBar                                                                      */
/* // ///////////////////////////////////////////////////////////////////////////// */

QToolBar {
    background: @bg;
}

