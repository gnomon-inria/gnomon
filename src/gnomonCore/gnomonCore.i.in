#pragma once

%module(directors="1") gnomoncore

%include "std_array.i"

%include <dtk_base.i>

%import <dtkCore.i>

%import <dtkImagingCore.i>

%{

// VTK also includes a Py_hash_t typedef definition for Python 2 that clashes
// with SWIG's preprocessor macro
#if PY_VERSION_HEX < 0x3020000
#ifdef Py_hash_t
#undef Py_hash_t
#endif
#endif

#include <dtkImagingCore>
#include <gnomonCore/gnomonAbstractCellComplexData.h>
#include <gnomonCore/gnomonAbstractCellComplexFromImage.h>
#include <gnomonCore/gnomonAbstractCellComplexReader.h>
#include <gnomonCore/gnomonAbstractCellGraphData.h>
#include <gnomonCore/gnomonAbstractCellGraphFromImage.h>
#include <gnomonCore/gnomonAbstractCellImageData.h>
#include <gnomonCore/gnomonAbstractCellImageFromImage.h>
#include <gnomonCore/gnomonAbstractMeshData.h>
#include <gnomonCore/gnomonAbstractDynamicForm.h>
#include <gnomonCore/gnomonAbstractFemSolver.h>
#include <gnomonCore/gnomonAbstractForm.h>
#include <gnomonCore/gnomonAbstractImagesFusion.h>
#include <gnomonCore/gnomonAbstractImagesRegistration.h>
#include <gnomonCore/gnomonAbstractImagesSerieFilter.h>
#include <gnomonCore/gnomonAbstractImagesSerieReader.h>
#include <gnomonCore/gnomonAbstractImagesSerieWriter.h>
#include <gnomonCore/gnomonAbstractModel.h>
#include <gnomonCore/gnomonAbstractSystemScenario.h>
#include <gnomonCore/gnomonCellComplex.h>
#include <gnomonCore/gnomonCellGraph.h>
#include <gnomonCore/gnomonCellImage.h>
#include <gnomonCore/gnomonCore.h>
#include <gnomonCore/gnomonCoreParameter.h>
#include <gnomonCore/gnomonDataManager.h>
#include <gnomonCore/gnomonDiscreteDynamicForm.h>
#include <gnomonCore/gnomonFileSystemFormReader.h>
#include <gnomonCore/gnomonFormVisitor.h>
#include <gnomonCore/gnomonImagesSerie.h>
#include <gnomonCore/gnomonIntensityImage.h>
#include <gnomonCore/gnomonMesh.h>
#include <gnomonCore/gnomonSphereForm.h>
#include <gnomonCore/gnomonSystem.h>
#include <gnomonCore/gnomonTime.h>
#include <gnomonCore/gnomonTypeDef.h>
#include <gnomonCore/gnomonWallForm.h>
#include <vtkPythonUtil.h>
#include <vtkImageData.h>

%}

%feature("director");
%feature("autodoc","1");

// /////////////////////////////////////////////////////////////////
// Macro undefinition
// /////////////////////////////////////////////////////////////////

#undef  GNOMONCORE_EXPORT
#define GNOMONCORE_EXPORT

%typemap(out) vtkImageData* {

    PyImport_ImportModule("vtk");

    $result = vtkPythonUtil::GetObjectFromPointer ( (vtkImageData*)$1 );
 }

%typemap(directorin) vtkImageData* {

    PyImport_ImportModule("vtk");

    $input = vtkPythonUtil::GetObjectFromPointer ( (vtkImageData*)$1 );
 }

%typemap(in) vtkImageData* {

    $1 = (vtkImageData*) vtkPythonUtil::GetPointerFromObject ( $input, "vtkImageData" );

    if ( $1 == NULL ) {
        qDebug("Fail to convert to vtkImageData*");
    }
}

%typemap(directorout) vtkImageData* {

    $result = (vtkImageData*) vtkPythonUtil::GetPointerFromObject ( $1, "vtkImageData" );

    if ( $result == NULL ) {
        qDebug("Fail to convert to vtkImageData*");
    }
}

%typemap(in) QMap<QString, gnomonCoreParameter *> {
    if (PyDict_Check($input)) {
        PyObject *key, *value;
        Py_ssize_t pos = 0;
        int r;
        while (PyDict_Next($input, &pos, &key, &value)) {
            QString k = QString(PyString_AsString(key));
            gnomonCoreParameter *v;
            void *s_v = 0;
            r = SWIG_ConvertPtr(value, &s_v, SWIGTYPE_p_gnomonCoreParameter, 0);
            if (SWIG_IsOK(r))
                v = reinterpret_cast<gnomonCoreParameter *>(s_v);
            $1.insert(k, v);
        }
    } else {
        qDebug("PyDict is expected as input. Empty QMap<QString, gnomonCoreParameter*> is returned.");
    }
}

%typemap(in) const QMap<QString, gnomonCoreParameter *>& {
    if (PyDict_Check($input)) {
        $1 = new QMap<QString, gnomonCoreParameter *>;
        PyObject *key, *value;
        Py_ssize_t pos = 0;
        int r;
        while (PyDict_Next($input, &pos, &key, &value)) {
            QString k = QString(PyString_AsString(key));
            gnomonCoreParameter *v;
            void *s_v = 0;
            r = SWIG_ConvertPtr(value, &s_v, SWIGTYPE_p_gnomonCoreParameter, 0);
            if (SWIG_IsOK(r))
                v = reinterpret_cast<gnomonCoreParameter *>(s_v);
            $1->insert(k, v);
        }
    } else {
        qDebug("PyDict is expected as input. Empty QMap<QString, gnomonCoreParameter*> is returned.");
    }
}

%typemap(freearg) const QMap<QString, gnomonCoreParameter *>& {
    if ($1) {
        delete $1;
    }
}

%typemap(directorout) QMap<QString, gnomonCoreParameter *> {
    PyObject *dict = static_cast<PyObject *>($1);
    if (PyDict_Check(dict)) {
        PyObject *key, *value;
        Py_ssize_t pos = 0;
        int r;
        while (PyDict_Next(dict, &pos, &key, &value)) {
            QString k = QString(PyString_AsString(key));
            gnomonCoreParameter *v;
            void *s_v = 0;
            r = SWIG_ConvertPtr(value, &s_v, SWIGTYPE_p_gnomonCoreParameter, 0);
            if (SWIG_IsOK(r))
                v = reinterpret_cast<gnomonCoreParameter *>(s_v);
            $result.insert(k, v);
        }
    } else {
        qDebug("PyDict is expected as input. Empty QMap<QString, gnomonCoreParameter*> is returned.");
    }
}

%typemap(in) QList<size_t> {
    if (PyList_Check($input)) {
        int i = 0;
        int end = PyList_Size($input);
        for(i;i!=end; ++i) {
            $1 << PyInt_AsLong(PyList_GET_ITEM($input, i));
        }
    } else {
        qDebug("PyList of integers is expected as input. Empty QList<size_t> is returned.");
    }
}

%typemap(in) const QList<size_t>& {
    if (PyList_Check($input)) {
        int i = 0;
        int end = PyList_Size($input);
        $1 = new QList<size_t>;
        for(i;i!=end; ++i) {
            ($1)->append(PyInt_AsLong(PyList_GET_ITEM($input, i)));
        }
    } else {
        qDebug("PyList of integers is expected as input. Empty QList<size_t> is returned.");
    }
}

%typemap(freearg) const QList<size_t>& {
    if ($1) {
        delete $1;
    }
}

%typemap(directorout) QList<size_t> {
    PyObject *list = static_cast<PyObject *>($1);
    if (PyList_Check(list)) {
        int i = 0;
        int end = PyList_Size(list);
        for(i;i<end; ++i) {
            PyObject *o = PyList_GET_ITEM(list, i);
            $result << PyInt_AsLong(o);
        }
    } else {
        qDebug("PyList of integers is expected as input. Empty QList<size_t> is returned.");
    }
}

%extend QVariant {
    void setValue(gnomonCellComplex *value) {
        $self->setValue(dtkMetaType::variantFromValue(value));
    }
    gnomonCellComplex* tognomonCellComplex() const {
        return $self->value<gnomonCellComplex *>();
    }

    void setValue(gnomonCellImage *value) {
        $self->setValue(dtkMetaType::variantFromValue(value));
    }
    gnomonCellImage* tognomonCellImage() const {
        return $self->value<gnomonCellImage *>();
    }

    void setValue(gnomonCellGraph *value) {
        $self->setValue(dtkMetaType::variantFromValue(value));
    }
    gnomonCellGraph* tognomonCellGraph() const {
        return $self->value<gnomonCellGraph *>();
    }

    void setValue(gnomonDiscreteDynamicForm *value) {
        $self->setValue(dtkMetaType::variantFromValue(value));
    }
    gnomonDiscreteDynamicForm* tognomonDiscreteDynamicForm() const {
        return $self->value<gnomonDiscreteDynamicForm *>();
    }

    void setValue(gnomonSphereForm *value) {
        $self->setValue(dtkMetaType::variantFromValue(value));
    }
    gnomonSphereForm* tognomonSphereForm() const {
        return $self->value<gnomonSphereForm *>();
    }

    void setValue(gnomonWallForm *value) {
        $self->setValue(dtkMetaType::variantFromValue(value));
    }
    gnomonWallForm* tognomonWallForm() const {
        return $self->value<gnomonWallForm *>();
    }
 }


%pythoncode %{
    def world():
        import dtkcore
        return dtkcore.dtkObjectManager_instance()
%}

%rename(ParameterBool)       gnomonCoreParameterBool;
%rename(ParameterString)     gnomonCoreParameterString;
%rename(ParameterStringList) gnomonCoreParameterStringList;
%rename(ParameterVariant)    gnomonCoreParameterVariant;

