#pragma once

%module(directors="1") gnomoncore

%include <dtk_base.i>

%import <dtkCore.i>

%import <dtkImagingCore.i>

%{

#include <dtkImaging>

#include <gnomonCore/gnomonCore.h>
#include <gnomonCore/gnomonAbstractCellComplexData.h>
#include <gnomonCore/gnomonCellComplex.h>
#include <gnomonCore/gnomonAbstractCellImageData.h>
#include <gnomonCore/gnomonCellImage.h>
#include <gnomonCore/gnomonAbstractCellGraphData.h>
#include <gnomonCore/gnomonCellGraph.h>
#include <gnomonCore/gnomonAbstractCellGraphFromImage.h>
#include <gnomonCore/gnomonAbstractCellComplexFromImage.h>
#include <gnomonCore/gnomonAbstractCellImageFromImage.h>
#include <gnomonCore/gnomonAbstractCellComplexReader.h>

%}

%feature("director");

// /////////////////////////////////////////////////////////////////
// Macro undefinition
// /////////////////////////////////////////////////////////////////

#undef  GNOMONCORE_EXPORT
#define GNOMONCORE_EXPORT

%extend QVariant {
    void setValue(gnomonCellComplex *value) {
        $self->setValue(dtkMetaType::variantFromValue(value));
    }
    void setValue(gnomonCellImage *value) {
        $self->setValue(dtkMetaType::variantFromValue(value));
    }
    void setValue(gnomonCellGraph *value) {
        $self->setValue(dtkMetaType::variantFromValue(value));
    }
    gnomonCellComplex* tognomonCellComplex() const {
        return $self->value<gnomonCellComplex *>();
    }
    gnomonCellImage* tognomonCellImage() const {
        return $self->value<gnomonCellImage *>();
    }
    gnomonCellGraph* tognomonCellGraph() const {
        return $self->value<gnomonCellGraph *>();
    }
 }


%pythoncode %{
    def world():
        import dtkcore
        return dtkcore.dtkObjectManager_instance()
%}

// /////////////////////////////////////////////////////////////////
// Wrapper input
// /////////////////////////////////////////////////////////////////

%include <gnomonCore/gnomonAbstractCellComplexData.h>
%include <gnomonCore/gnomonCellComplex.h>
%include <gnomonCore/gnomonAbstractCellImageData.h>
%include <gnomonCore/gnomonCellImage.h>
%include <gnomonCore/gnomonAbstractCellGraphData.h>
%include <gnomonCore/gnomonCellGraph.h>
%include <gnomonCore/gnomonAbstractCellGraphFromImage.h>
%include <gnomonCore/gnomonAbstractCellComplexFromImage.h>
%include <gnomonCore/gnomonAbstractCellImageFromImage.h>
%include <gnomonCore/gnomonAbstractCellComplexReader.h>

%include "@dtk_WRAP_QVARIANT@"

