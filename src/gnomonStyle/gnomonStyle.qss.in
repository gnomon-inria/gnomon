QLineEdit {
    color: "@GNOMON_STYLE_FOREGROUNDCOLOR@";
    background: "@GNOMON_STYLE_BACKGROUNDCOLOR@";

    border: 1px solid @GNOMON_STYLE_BORDERCOLOR@;
    border-radius: 4px;
}

QFrame {
    color: "@GNOMON_STYLE_FOREGROUNDCOLOR@";
    background: "@GNOMON_STYLE_BACKGROUNDALTCOLOR@";
}

QPlainTextEdit {
    color: "@GNOMON_STYLE_FOREGROUNDCOLOR@";
    background: "@GNOMON_STYLE_BACKGROUNDCOLOR@";
}

QPushButton, QToolButton {
    color: "@GNOMON_STYLE_FOREGROUNDCOLOR@";
    background: "@GNOMON_STYLE_BACKGROUNDCOLOR@";

    border: 1px solid @GNOMON_STYLE_BORDERCOLOR@;
    border-radius: 4px;
}

QToolBar::left {
    background: "@GNOMON_STYLE_BACKGROUNDALTCOLOR@";
}

