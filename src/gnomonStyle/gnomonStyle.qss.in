/* *****************************************************************
;; QtWidgets
;; ******************************************************************/

QCheckBox, QListWidget QCheckBox {
    color: @GNOMON_STYLE_FOREGROUNDCOLOR@;
    spacing: 5px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
}

QCheckBox::indicator:unchecked {
    image: url(":gnomonStyle/gnomonStyleCheckBox.png");
}

QCheckBox::indicator:checked {
    image: url(":gnomonStyle/gnomonStyleCheckBox-checked.png");
}

QComboBox {
    color: @GNOMON_STYLE_FOREGROUNDCOLOR@;
    border: 1px solid @GNOMON_STYLE_BORDERCOLOR@;
    border-radius: 2px;
}

QComboBox:!editable, QComboBox::drop-down:editable {
    background: @GNOMON_STYLE_BACKGROUNDCOLOR@;
}

QComboBox:!editable:on, QComboBox::drop-down:editable:on {
    background: @GNOMON_STYLE_BACKGROUNDCOLOR@;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 15px;

    border-left-width: 1px;
    border-left-color: @GNOMON_STYLE_BORDERCOLOR@;
    border-left-style: solid;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
}

QComboBox::down-arrow {
    width: 8px;
    image: url(":gnomonStyle/gnomonStyleComboBoxDownArrow.png");
}

QComboBox QListView {
    background-color: @GNOMON_STYLE_BACKGROUNDCOLOR@;
    border-top: 1px solid @GNOMON_STYLE_BORDERCOLOR@;
    border-bottom: none;
}

QLineEdit {
    color: @GNOMON_STYLE_FOREGROUNDCOLOR@;
    background: @GNOMON_STYLE_BACKGROUNDCOLOR@;

    border: 1px solid @GNOMON_STYLE_BORDERCOLOR@;
    border-radius: 2px;
}

QFrame {
    color: @GNOMON_STYLE_FOREGROUNDCOLOR@;
    background: @GNOMON_STYLE_BACKGROUNDALTCOLOR@;
}

QHeaderView::section {
    background-color: @GNOMON_STYLE_BACKGROUNDALTCOLOR@;
    color: @GNOMON_STYLE_FOREGROUNDCOLOR@;
    border: none;
    padding: 4px;
}

/* QListView::item { */
/*     color: @GNOMON_STYLE_FOREGROUNDCOLOR@; */
/* } */

/* QListView::item:!active { */
/*     background: @GNOMON_STYLE_BACKGROUNDCOLOR@; */
/* } */

