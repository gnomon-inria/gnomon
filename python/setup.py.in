from setuptools import setup, find_packages
import os

pkgs = find_packages(os.path.relpath('${CMAKE_CURRENT_SOURCE_DIR}'))

setup(name='gnomon_utils',
      version='${gnomon_VERSION}',
      package_dir={'': os.path.relpath('${CMAKE_CURRENT_SOURCE_DIR}')},
      packages=pkgs,
      entry_points={
        "console_scripts": [
            "gnomon-utils=gnomon_utils.gnomonCommandLineTools:main"
        ]
      },
      package_data={"": ["templates/*", "templates/*/*", "templates/*/*/*", "schematic/*"]},
      include_package_data=True,
      )
